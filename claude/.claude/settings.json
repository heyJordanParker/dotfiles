{
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Skill(brainstorming)",
      "Skill(building-skills)",
      "Skill(condition-based-waiting)",
      "Skill(defense-in-depth)",
      "Skill(dispatching-parallel-agents)",
      "Skill(executing-plans)",
      "Skill(finishing-a-development-branch)",
      "Skill(naming)",
      "Skill(receiving-code-review)",
      "Skill(requesting-code-review)",
      "Skill(root-cause-tracing)",
      "Skill(sharing-skills)",
      "Skill(subagent-driven-development)",
      "Skill(systematic-debugging)",
      "Skill(test-driven-development)",
      "Skill(testing-skills-with-subagents)",
      "Skill(updating-claude-documentation)",
      "Skill(using-git-worktrees)",
      "Skill(verification-before-completion)",
      "Skill(writing-plans)"
    ]
  },
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cat $HOME/.claude/hooks/session-start.md"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "INPUT=$(cat); SESSION_ID=$(echo \"$INPUT\" | jq -r '.session_id'); [[ \"$SESSION_ID\" != agent-* ]] && echo \"$INPUT\" | jq -r '.transcript_path' > /tmp/claude-transcript-$TMUX_PANE || true"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "INPUT=$(cat); SESSION_ID=$(echo \"$INPUT\" | jq -r '.session_id'); if [[ \"$SESSION_ID\" != agent-* ]] && [ -n \"$TMUX_PANE\" ]; then STABLE_ID=$(tmux display-message -t \"$TMUX_PANE\" -p '#{session_name}:#{window_index}:#{pane_index}' 2>/dev/null); [ -n \"$STABLE_ID\" ] && mkdir -p ~/.claude/tmux-sessions && echo \"$SESSION_ID\" > ~/.claude/tmux-sessions/\"${STABLE_ID//:/--}\"; fi"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/jordan/.claude/hooks/retro-reminder.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/jordan/.claude/hooks/block-git-revert.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "/Users/jordan/.claude/hooks/block-unsafe-delete.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "prompt",
            "prompt": "Before asking a question:\n\n- Research first. Only ask if <90% confident after checking codebase and docs.\n- If over 90% confident, decide yourself and mention it in the question text.\n- Make questions self-contained. User should answer without reading files, a plan you created, or anything else you said. Add details, code examples, annotated file trees, and anything else necessary to explain the issue effectively.\n- Provide 4+ options. Yes/no wastes the tool.\n- One decision per question. Don't batch."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ \"$(tmux display-message -t \"$TMUX_PANE\" -p '#{window_active}')\" = \"0\" ]; then touch /tmp/claude-waiting-$TMUX_PANE; fi"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cat $HOME/.claude/hooks/user-prompt-submit.md"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/rm -f /tmp/claude-waiting-$TMUX_PANE"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/rm -f /tmp/claude-waiting-$TMUX_PANE"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"$TMUX_PANE\" ]; then STABLE_ID=$(tmux display-message -t \"$TMUX_PANE\" -p '#{session_name}:#{window_index}:#{pane_index}' 2>/dev/null); [ -n \"$STABLE_ID\" ] && rm -f ~/.claude/tmux-sessions/\"${STABLE_ID//:/--}\"; fi"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "if [ \"$(tmux display-message -t \"$TMUX_PANE\" -p '#{window_active}')\" = \"0\" ]; then touch /tmp/claude-waiting-$TMUX_PANE; fi"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "fileSuggestion": {
    "type": "command",
    "command": "~/.claude/file-suggestion.sh"
  },
  "enabledPlugins": {
    "php-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "dev-browser@dev-browser-marketplace": true,
    "ralph-wiggum@claude-code-plugins": true
  },
  "alwaysThinkingEnabled": true
}
