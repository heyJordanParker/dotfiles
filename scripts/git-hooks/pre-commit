#!/usr/bin/env python3
"""Pre-commit: run repo maintenance so generated files and stow links stay
current as sources change. Never blocks the commit."""

import os
import subprocess
import sys

root = subprocess.run(
    ["git", "rev-parse", "--show-toplevel"],
    capture_output=True, text=True,
).stdout.strip()
subprocess.run([sys.executable, os.path.join(root, "scripts", "sync.py")])
