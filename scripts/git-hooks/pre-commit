#!/usr/bin/env python3
"""Pre-commit: run repo maintenance so generated files and stow links stay
current as sources change. Never blocks the commit."""

import os
import subprocess
import sys

root = subprocess.run(
    ["git", "rev-parse", "--show-toplevel"],
    capture_output=True, text=True,
).stdout.strip()
result = subprocess.run(
    [sys.executable, os.path.join(root, "scripts", "sync.py")],
    capture_output=True, text=True,
)
if result.returncode:
    sys.stderr.write("sync.py failed — stow links and generated files are stale:\n")
    sys.stderr.write(result.stdout + result.stderr)
