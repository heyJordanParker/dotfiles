.DS_Store

# subagent Evidence directories and Plans — session-scoped work product, never committed
/docs/agents/
/docs/plans/
/.claude/*
!/.claude/rules/

# tracer's per-repo disk cache (created at any repo root tracer is run in)
.tracer-cache/

# Python dev environment, bytecode, and tool caches (dev-only; runtime is stdlib)
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
