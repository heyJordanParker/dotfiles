#!/bin/sh
# trace — plugin launcher for the tracer code-intelligence CLI.
#
# The plugin marketplace copies this whole directory to every consumer's
# plugin cache and puts this file on PATH. tracer is a native Rust binary,
# so a single committed file cannot serve every platform. This launcher
# resolves the right binary for the host:
#
#   1. uname -sm matches a committed prebuilt (mac-arm64 / linux-x86_64 /
#      linux-arm64) -> exec it.
#   2. A previously locally-built binary is cached in the plugin dir
#      -> exec it.
#   3. cargo is available -> build --release from the crate source shipped
#      alongside this launcher, cache the binary, exec it.
#   4. No toolchain -> print an actionable "install Rust" message (the same
#      shape `trace doctor` uses for a missing external binary) and exit
#      non-zero.
#
# The SessionStart primer hook independently swallows any failure and exits
# 0 so sessions never break; a direct `trace ...` call gets the real error.

set -eu

DIST="$(CDPATH= cd -- "$(dirname -- "$0")/tracer-dist" && pwd)"
CACHE="$DIST/built"

case "$(uname -sm)" in
    'Darwin arm64')  PREBUILT="$DIST/bin/mac-arm64/trace" ;;
    'Linux x86_64')  PREBUILT="$DIST/bin/linux-x86_64/trace" ;;
    'Linux aarch64') PREBUILT="$DIST/bin/linux-arm64/trace" ;;
    *)               PREBUILT='' ;;
esac

if [ -n "$PREBUILT" ] && [ -x "$PREBUILT" ]; then
    exec "$PREBUILT" "$@"
fi

if [ -x "$CACHE/trace" ]; then
    exec "$CACHE/trace" "$@"
fi

if command -v cargo >/dev/null 2>&1; then
    # Build from the shipped crate source. Plain network build — reaching
    # crates.io is expected; there is no vendored-crate fallback.
    if cargo build --release --quiet --manifest-path "$DIST/crate/Cargo.toml" >&2; then
        mkdir -p "$CACHE"
        cp "$DIST/crate/target/release/trace" "$CACHE/trace"
        exec "$CACHE/trace" "$@"
    fi
    echo "trace: build from source failed (see cargo output above)." >&2
    exit 1
fi

case "$(uname -s)" in
    Darwin) HINT='brew install rustup-init && rustup-init -y  # or: https://rustup.rs' ;;
    Linux)  HINT='https://rustup.rs   (curl --proto =https --tlsv1.2 -sSf https://sh.rustup.rs | sh)' ;;
    *)      HINT='https://rustup.rs' ;;
esac

cat >&2 <<EOF
trace: no prebuilt binary for this platform ($(uname -sm)) and no Rust
toolchain to build from source.

Missing:
  ✗ cargo (Rust toolchain)
    install: $HINT

Then re-run any \`trace\` command — the launcher builds and caches the
binary on first use.
EOF
exit 1
