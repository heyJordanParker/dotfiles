{
  "fileSuggestion": {
    "type": "command",
    "command": "~/.claude/file-suggestion.sh"
  },
  "cleanupPeriodDays": 100000000,
  "skillListingBudgetFraction": 0.02,
  "env": {
    "ANTHROPIC_BASE_URL": "http://127.0.0.1:8317",
    "CLAUDE_CODE_ENABLE_FINE_GRAINED_TOOL_STREAMING": "1",
    "CLAUDE_CODE_MAX_CONTEXT_TOKENS": "272000",
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1",
    "ENABLE_TOOL_SEARCH": "true",
    "EDITOR": "prompt-editor",
    "USER_TYPE": "ant",
    "CLAUDE_CODE_PLUGIN_DIRS": "~/Developer/tracer"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Skill(building-skills)",
      "Skill(naming)",
      "Skill(sharing-skills)",
      "Skill(testing-skills-with-subagents)",
      "Skill(updating-claude-documentation)",
      "Skill(using-git-worktrees)",
      "Skill(verification-before-completion)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git diff:*)",
      "Bash(git lg:*)",
      "Bash(git log:*)",
      "Bash(git status:*)",
      "Bash(git branch:*)",
      "Bash(git changes:*)",
      "Bash(brew install:*)",
      "Bash(ls:*)",
      "mcp__pencil",
      "Bash(stow:*)",
      "Bash(codex:*)"
    ],
    "deny": [
      "EnterWorktree",
      "AskUserQuestion",
      "ExitWorktree"
    ],
    "defaultMode": "bypassPermissions"
  },
  "modelPicker": {
    "options": [
      {
        "model": "gpt-6-astra",
        "label": "GPT-6 Astra (Codex)"
      },
      {
        "model": "gpt-6.1-sol",
        "label": "GPT-6.1 Sol (Codex)"
      }
    ]
  },
  "model": "opus",
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "if [ \"$(tmux display-message -t \"$TMUX_PANE\" -p '#{window_active}')\" = \"0\" ]; then touch /tmp/claude-waiting-$TMUX_PANE; fi"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$SUPERSET_HOME_DIR\" ] && [ -x \"$SUPERSET_HOME_DIR/hooks/notify.sh\" ] && SUPERSET_AGENT_ID=claude \"$SUPERSET_HOME_DIR/hooks/notify.sh\" || true"
          }
        ]
      },
      {
        "matcher": "Read|Glob|Grep|Write|Edit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/auto_approve_permissions.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$SUPERSET_HOME_DIR\" ] && [ -x \"$SUPERSET_HOME_DIR/hooks/notify.sh\" ] && SUPERSET_AGENT_ID=claude \"$SUPERSET_HOME_DIR/hooks/notify.sh\" || true"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/sync_shaping.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/transition_state_after_plan.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$SUPERSET_HOME_DIR\" ] && [ -x \"$SUPERSET_HOME_DIR/hooks/notify.sh\" ] && SUPERSET_AGENT_ID=claude \"$SUPERSET_HOME_DIR/hooks/notify.sh\" || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/inject_honcho_memory.py",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/combine_hooks.py block_builtin_subagents block_spawning block_worktree_isolation",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/combine_hooks.py block_branch_change block_composed_commands block_denied_access block_git_revert block_invalid_browsers block_memory_access block_path_assignment block_spawning block_unauthorized_commits block_unbounded_sort block_unsafe_delete block_writes protect_session_state",
            "timeout": 65
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/combine_hooks.py block_denied_access block_writes protect_session_state",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/combine_hooks.py block_denied_access block_writes",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "WebFetch|WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/block_research_web_tools.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Workflow|RemoteTrigger",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/block_spawning.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "EnterWorktree",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/block_worktree_isolation.py",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/rm -f /tmp/claude-waiting-$TMUX_PANE"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"$TMUX_PANE\" ]; then STABLE_ID=$(tmux display-message -t \"$TMUX_PANE\" -p '#{session_name}:#{window_index}:#{pane_index}' 2>/dev/null); [ -n \"$STABLE_ID\" ] && rm -f ~/.claude/tmux-sessions/\"${STABLE_ID//:/--}\"; fi"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$SUPERSET_HOME_DIR\" ] && [ -x \"$SUPERSET_HOME_DIR/hooks/notify.sh\" ] && SUPERSET_AGENT_ID=claude \"$SUPERSET_HOME_DIR/hooks/notify.sh\" || true"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "INPUT=$(cat); printf '%s' \"$INPUT\" | jq -r '.transcript_path' > /tmp/claude-transcript-$TMUX_PANE || true"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "INPUT=$(cat); SESSION_ID=$(printf '%s' \"$INPUT\" | jq -r '.session_id'); if [ -n \"$TMUX_PANE\" ]; then STABLE_ID=$(tmux display-message -t \"$TMUX_PANE\" -p '#{session_name}:#{window_index}:#{pane_index}' 2>/dev/null); [ -n \"$STABLE_ID\" ] && mkdir -p ~/.claude/tmux-sessions && echo \"$SESSION_ID\" > ~/.claude/tmux-sessions/\"${STABLE_ID//:/--}\"; fi"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$SUPERSET_HOME_DIR\" ] && [ -x \"$SUPERSET_HOME_DIR/hooks/notify.sh\" ] && SUPERSET_AGENT_ID=claude \"$SUPERSET_HOME_DIR/hooks/notify.sh\" || true"
          }
        ]
      },
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/jordan/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/inject_honcho_memory.py",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/record_session_event.py"
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/reload_stale_skills.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ \"$(tmux display-message -t \"$TMUX_PANE\" -p '#{window_active}')\" = \"0\" ]; then touch /tmp/claude-waiting-$TMUX_PANE; fi"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$SUPERSET_HOME_DIR\" ] && [ -x \"$SUPERSET_HOME_DIR/hooks/notify.sh\" ] && SUPERSET_AGENT_ID=claude \"$SUPERSET_HOME_DIR/hooks/notify.sh\" || true"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/close_abandoned_browsers.py",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/remember_turn.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/block_silent_stop.py"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/close_abandoned_browsers.py",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/remember_turn.py",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/rm -f /tmp/claude-waiting-$TMUX_PANE"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$SUPERSET_HOME_DIR\" ] && [ -x \"$SUPERSET_HOME_DIR/hooks/notify.sh\" ] && SUPERSET_AGENT_ID=claude \"$SUPERSET_HOME_DIR/hooks/notify.sh\" || true"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/classify_intent.py",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/inject_honcho_memory.py",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/combine_hooks.py record_session_event reload_stale_skills"
          }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/reload_stale_skills.py"
          }
        ]
      }
    ]
  },
  "worktree": {
    "bgIsolation": "none"
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "dev-browser@dev-browser-marketplace": false,
    "skill-creator@claude-plugins-official": true,
    "dent@getdent": true,
    "cmod@cmod": true
  },
  "extraKnownMarketplaces": {
    "getdent": {
      "source": {
        "source": "github",
        "repo": "getdent/skill"
      }
    },
    "cmod": {
      "source": {
        "source": "github",
        "repo": "heyJordanParker/cmod"
      }
    }
  },
  "pluginConfigs": {
    "tracer@inline": {
      "options": {
        "tracerOnly": true
      }
    }
  },
  "outputStyle": "Concise",
  "alwaysThinkingEnabled": true,
  "modelSettings": {
    "fable": {
      "effortLevel": "medium"
    },
    "opus": {
      "effortLevel": "high"
    },
    "claude-opus-5": {
      "effortLevel": "high"
    }
  },
  "autoCompactWindow": 700000,
  "promptSuggestionEnabled": false,
  "agent": "cto",
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "fileCheckpointingEnabled": false,
  "voiceEnabled": true
}
