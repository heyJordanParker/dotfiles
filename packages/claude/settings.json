{
  "fileSuggestion": {
    "type": "command",
    "command": "~/.claude/file-suggestion.sh"
  },
  "cleanupPeriodDays": 100000000,
  "skillListingBudgetFraction": 0.02,
  "env": {
    "CLAUDE_CODE_ENABLE_TASKS": "true",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_NO_FLICKER": "1",
    "EDITOR": "prompt-editor",
    "USER_TYPE": "ant"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Skill(building-skills)",
      "Skill(naming)",
      "Skill(sharing-skills)",
      "Skill(testing-skills-with-subagents)",
      "Skill(updating-claude-documentation)",
      "Skill(using-git-worktrees)",
      "Skill(verification-before-completion)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git diff:*)",
      "Bash(git lg:*)",
      "Bash(git log:*)",
      "Bash(git status:*)",
      "Bash(git branch:*)",
      "Bash(git changes:*)",
      "Bash(brew install:*)",
      "Bash(ls:*)",
      "mcp__pencil",
      "Bash(stow:*)",
      "Bash(codex-run:*)",
      "Bash(codex:*)"
    ],
    "deny": [
      "EnterWorktree",
      "ExitWorktree"
    ],
    "defaultMode": "bypassPermissions"
  },
  "model": "claude-fable-5[1m]",
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "if [ \"$(tmux display-message -t \"$TMUX_PANE\" -p '#{window_active}')\" = \"0\" ]; then touch /tmp/claude-waiting-$TMUX_PANE; fi"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$SUPERSET_HOME_DIR\" ] && [ -x \"$SUPERSET_HOME_DIR/hooks/notify.sh\" ] && SUPERSET_AGENT_ID=claude \"$SUPERSET_HOME_DIR/hooks/notify.sh\" || true"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/jordan/.claude/hooks/herdr-agent-state.sh' blocked",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Glob|Grep|Write|Edit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/auto_approve_permissions.py"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/record_session_event.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$SUPERSET_HOME_DIR\" ] && [ -x \"$SUPERSET_HOME_DIR/hooks/notify.sh\" ] && SUPERSET_AGENT_ID=claude \"$SUPERSET_HOME_DIR/hooks/notify.sh\" || true"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/record_session_event.py"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/sync_shaping.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/transition_state_after_plan.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$SUPERSET_HOME_DIR\" ] && [ -x \"$SUPERSET_HOME_DIR/hooks/notify.sh\" ] && SUPERSET_AGENT_ID=claude \"$SUPERSET_HOME_DIR/hooks/notify.sh\" || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "prompt",
            "prompt": "Evaluate this subagent dispatch for over-instruction. The prompt being sent to a subagent is in tool_input.prompt from $ARGUMENTS.\n\nBlock if ANY of these are true:\n1. Contains pre-researched file contents (quoted code blocks with file paths, command output dumps, or content that looks copied from a file read)\n2. Specifies implementation steps — line numbers to change, specific code to write, step-by-step HOW instructions (exception: mechanical tasks like bulk renames are fine)\n3. Scoped too narrowly — asks the agent to review a single method or line instead of the module/feature/service boundary\n4. Prescribes the agent's investigation or implementation path — tells it which files to read in what order, which functions to trace, or what conclusions to reach, instead of letting it explore from the goal\n\nDo NOT block if:\n- The prompt communicates WHY (user story, business context, motivation) and WHAT (goal, deliverable, acceptance criteria)\n- It describes scope — which areas are involved, what changed and why, or what the goal is. This is goal-setting, not pre-research\n- It includes an annotated file tree (paths with brief annotations — this is navigation, not pre-research)\n- It includes a unique finding the subagent won't realistically discover (e.g., a runtime behavior observed in logs, a user-reported symptom, a constraint from a conversation with the user)\n- It uses Story/Business/Goal/DoD structure\n\nReturn JSON:\n- Pass: {\"decision\": \"approve\"}\n- Fail: {\"decision\": \"block\", \"reason\": \"[What's wrong]. Fix: [How to fix the prompt].\"}",
            "timeout": 15,
            "statusMessage": "Validating subagent prompt quality..."
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "prompt",
            "prompt": "Question quality gate. Evaluate the question in tool_input from $ARGUMENTS.\n\nReject if:\n\n1. Asks permission to act: \"Can I proceed?\", \"Want me to continue?\", \"Shall I?\", \"Would you like me to...\". Act or present information — don't ask to act.\n\n2. Hedges about unverified state: \"probably\", \"likely\", \"I think\", \"should be\", \"might be\". Verify first, then ask.\n\n3. Fewer than 4 distinct options. Yes/no and single-option approval (\"does this work?\") waste the tool. Present 4+ meaningfully different alternatives with tradeoffs.\n\n4. Dumps decisions without research: \"What next?\", \"How should I handle this?\". Research and present concrete options.\n\n5. Not self-contained: Requires reading external context — \"as mentioned above\", \"the plan I showed\", \"as discussed\". Include all necessary context inline.\n\n6. Prompts the user to respond: Flattery (\"Great question\"), directive closing (\"Which one?\", \"Which do you prefer?\"), or nudges (\"Let me know\", \"Thoughts?\", \"Sound good?\"). Present options and stop.\n\n7. Batches multiple independent decisions. One question = one decision.\n\nReturn JSON only:\n- Pass: {\"ok\": true}\n- Fail: {\"ok\": false, \"reason\": \"[Specific issue]. Fix: [What to do].\"}",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/jordan/.claude/hooks/herdr-agent-state.sh' working",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/block_branch_change.py",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/block_git_revert.py",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/block_path_assignment.py",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/block_unauthorized_commits.py",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/block_unsafe_delete.py",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/guard_trace.py",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/inject_docs.py",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/block_builtin_subagents.py",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/block_worktree_isolation.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/block_edits_during_proposal.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "EnterWorktree",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/block_enter_worktree.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "TeamDelete",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/block_team_deletion.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/enforce_solo_mode.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Read|Glob|Grep|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/enrich_on_read.py",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash|Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/protect_session_state.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Read|Skill",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/record_session_event.py"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/review_doc_edit.py",
            "timeout": 120
          },
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/validate_planning_docs.py",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/validate_plan_quality.py",
            "timeout": 180
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/rm -f /tmp/claude-waiting-$TMUX_PANE"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"$TMUX_PANE\" ]; then STABLE_ID=$(tmux display-message -t \"$TMUX_PANE\" -p '#{session_name}:#{window_index}:#{pane_index}' 2>/dev/null); [ -n \"$STABLE_ID\" ] && rm -f ~/.claude/tmux-sessions/\"${STABLE_ID//:/--}\"; fi"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$SUPERSET_HOME_DIR\" ] && [ -x \"$SUPERSET_HOME_DIR/hooks/notify.sh\" ] && SUPERSET_AGENT_ID=claude \"$SUPERSET_HOME_DIR/hooks/notify.sh\" || true"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/jordan/.claude/hooks/herdr-agent-state.sh' release",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "INPUT=$(cat); printf '%s' \"$INPUT\" | jq -r '.transcript_path' > /tmp/claude-transcript-$TMUX_PANE || true"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "INPUT=$(cat); SESSION_ID=$(printf '%s' \"$INPUT\" | jq -r '.session_id'); if [ -n \"$TMUX_PANE\" ]; then STABLE_ID=$(tmux display-message -t \"$TMUX_PANE\" -p '#{session_name}:#{window_index}:#{pane_index}' 2>/dev/null); [ -n \"$STABLE_ID\" ] && mkdir -p ~/.claude/tmux-sessions && echo \"$SESSION_ID\" > ~/.claude/tmux-sessions/\"${STABLE_ID//:/--}\"; fi"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$SUPERSET_HOME_DIR\" ] && [ -x \"$SUPERSET_HOME_DIR/hooks/notify.sh\" ] && SUPERSET_AGENT_ID=claude \"$SUPERSET_HOME_DIR/hooks/notify.sh\" || true"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/jordan/.claude/hooks/herdr-agent-state.sh' idle",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "IAI_MCP_SESSION_RECALL_CLI=$HOME/.local/bin/iai-mcp $HOME/Developer/services/iai-personal-memory-engine/src/iai_mcp/_deploy/hooks/iai-mcp-session-recall.sh",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/load_trace_context.py",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/reload_harness_context.py",
            "timeout": 20
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/record_session_event.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ \"$(tmux display-message -t \"$TMUX_PANE\" -p '#{window_active}')\" = \"0\" ]; then touch /tmp/claude-waiting-$TMUX_PANE; fi"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$SUPERSET_HOME_DIR\" ] && [ -x \"$SUPERSET_HOME_DIR/hooks/notify.sh\" ] && SUPERSET_AGENT_ID=claude \"$SUPERSET_HOME_DIR/hooks/notify.sh\" || true"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/jordan/.claude/hooks/herdr-agent-state.sh' idle",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "IAI_MCP_SESSION_CAPTURE_CLI=$HOME/.local/bin/iai-mcp $HOME/Developer/services/iai-personal-memory-engine/src/iai_mcp/_deploy/hooks/iai-mcp-session-capture.sh",
            "timeout": 35
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/babysitter.py",
            "timeout": 90
          },
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/record_session_event.py"
          },
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/validate_completion.py",
            "timeout": 90
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/rm -f /tmp/claude-waiting-$TMUX_PANE"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$SUPERSET_HOME_DIR\" ] && [ -x \"$SUPERSET_HOME_DIR/hooks/notify.sh\" ] && SUPERSET_AGENT_ID=claude \"$SUPERSET_HOME_DIR/hooks/notify.sh\" || true"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/jordan/.claude/hooks/herdr-agent-state.sh' working",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/Developer/services/iai-personal-memory-engine/src/iai_mcp/_deploy/hooks/iai-mcp-turn-capture.sh",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/classify_intent.py",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/record_session_event.py"
          },
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/update_goal.py",
            "timeout": 70
          }
        ]
      }
    ]
  },
  "worktree": {
    "bgIsolation": "none"
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "dev-browser@dev-browser-marketplace": false,
    "skill-creator@claude-plugins-official": true
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "medium",
  "agent": "cto",
  "autoUpdatesChannel": "latest",
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "fileCheckpointingEnabled": false,
  "teammateMode": "in-process",
  "remoteControlAtStartup": true,
  "voiceEnabled": true
}
