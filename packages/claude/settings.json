{
  "fileSuggestion": {
    "type": "command",
    "command": "~/.claude/file-suggestion.sh"
  },
  "cleanupPeriodDays": 100000000,
  "skillListingBudgetFraction": 0.02,
  "env": {
    "CLAUDE_CODE_ENABLE_TASKS": "true",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_MAX_SUBAGENTS_PER_SESSION": "1000000",
    "CLAUDE_CODE_NO_FLICKER": "1",
    "EDITOR": "prompt-editor",
    "USER_TYPE": "ant"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Skill(building-skills)",
      "Skill(naming)",
      "Skill(sharing-skills)",
      "Skill(testing-skills-with-subagents)",
      "Skill(updating-claude-documentation)",
      "Skill(using-git-worktrees)",
      "Skill(verification-before-completion)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git diff:*)",
      "Bash(git lg:*)",
      "Bash(git log:*)",
      "Bash(git status:*)",
      "Bash(git branch:*)",
      "Bash(git changes:*)",
      "Bash(brew install:*)",
      "Bash(ls:*)",
      "mcp__pencil",
      "Bash(stow:*)",
      "Bash(codex-run:*)",
      "Bash(codex:*)"
    ],
    "deny": [
      "EnterWorktree",
      "ExitWorktree"
    ],
    "defaultMode": "bypassPermissions"
  },
  "model": "opus[1m]",
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "if [ \"$(tmux display-message -t \"$TMUX_PANE\" -p '#{window_active}')\" = \"0\" ]; then touch /tmp/claude-waiting-$TMUX_PANE; fi"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$SUPERSET_HOME_DIR\" ] && [ -x \"$SUPERSET_HOME_DIR/hooks/notify.sh\" ] && SUPERSET_AGENT_ID=claude \"$SUPERSET_HOME_DIR/hooks/notify.sh\" || true"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/jordan/.claude/hooks/herdr-agent-state.sh' blocked",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Glob|Grep|Write|Edit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/auto_approve_permissions.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$SUPERSET_HOME_DIR\" ] && [ -x \"$SUPERSET_HOME_DIR/hooks/notify.sh\" ] && SUPERSET_AGENT_ID=claude \"$SUPERSET_HOME_DIR/hooks/notify.sh\" || true"
          }
        ]
      },
      {
        "matcher": "Bash|Write|Edit|MultiEdit|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/remember_tool_use.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/sync_shaping.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/transition_state_after_plan.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$SUPERSET_HOME_DIR\" ] && [ -x \"$SUPERSET_HOME_DIR/hooks/notify.sh\" ] && SUPERSET_AGENT_ID=claude \"$SUPERSET_HOME_DIR/hooks/notify.sh\" || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/jordan/.claude/hooks/herdr-agent-state.sh' working",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/block_branch_change.py",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/block_git_revert.py",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/block_invalid_browsers.py",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/block_memory_access.py",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/block_path_assignment.py",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/block_unauthorized_commits.py",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/block_unsafe_delete.py",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/enforce_background_codex_run.py",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/guard_trace.py",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/inject_docs.py",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/name_memory_caller.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/block_builtin_subagents.py",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/block_worktree_isolation.py",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/block_wrong_harness.py",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/inject_honcho_memory.py",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/block_denied_access.py",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/block_writes.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "EnterWorktree",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/block_enter_worktree.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "WebFetch|WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/block_research_web_tools.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/block_spawning.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Read|Glob|Grep|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/enrich_on_read.py",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash|Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/protect_session_state.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/review_doc_edit.py",
            "timeout": 120
          },
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/validate_planning_docs.py",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/validate_plan_quality.py",
            "timeout": 180
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/validate_question_quality.py",
            "timeout": 90
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/rm -f /tmp/claude-waiting-$TMUX_PANE"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"$TMUX_PANE\" ]; then STABLE_ID=$(tmux display-message -t \"$TMUX_PANE\" -p '#{session_name}:#{window_index}:#{pane_index}' 2>/dev/null); [ -n \"$STABLE_ID\" ] && rm -f ~/.claude/tmux-sessions/\"${STABLE_ID//:/--}\"; fi"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$SUPERSET_HOME_DIR\" ] && [ -x \"$SUPERSET_HOME_DIR/hooks/notify.sh\" ] && SUPERSET_AGENT_ID=claude \"$SUPERSET_HOME_DIR/hooks/notify.sh\" || true"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/jordan/.claude/hooks/herdr-agent-state.sh' release",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/end_codex_jobs.py",
            "timeout": 1
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "INPUT=$(cat); printf '%s' \"$INPUT\" | jq -r '.transcript_path' > /tmp/claude-transcript-$TMUX_PANE || true"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "INPUT=$(cat); SESSION_ID=$(printf '%s' \"$INPUT\" | jq -r '.session_id'); if [ -n \"$TMUX_PANE\" ]; then STABLE_ID=$(tmux display-message -t \"$TMUX_PANE\" -p '#{session_name}:#{window_index}:#{pane_index}' 2>/dev/null); [ -n \"$STABLE_ID\" ] && mkdir -p ~/.claude/tmux-sessions && echo \"$SESSION_ID\" > ~/.claude/tmux-sessions/\"${STABLE_ID//:/--}\"; fi"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$SUPERSET_HOME_DIR\" ] && [ -x \"$SUPERSET_HOME_DIR/hooks/notify.sh\" ] && SUPERSET_AGENT_ID=claude \"$SUPERSET_HOME_DIR/hooks/notify.sh\" || true"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/jordan/.claude/hooks/herdr-agent-state.sh' idle",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/inject_honcho_memory.py",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/record_session_event.py"
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/load_trace_context.py",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/reload_harness_context.py",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ \"$(tmux display-message -t \"$TMUX_PANE\" -p '#{window_active}')\" = \"0\" ]; then touch /tmp/claude-waiting-$TMUX_PANE; fi"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$SUPERSET_HOME_DIR\" ] && [ -x \"$SUPERSET_HOME_DIR/hooks/notify.sh\" ] && SUPERSET_AGENT_ID=claude \"$SUPERSET_HOME_DIR/hooks/notify.sh\" || true"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/jordan/.claude/hooks/herdr-agent-state.sh' idle",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/babysitter.py",
            "timeout": 90
          },
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/close_abandoned_browsers.py",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/remember_agent_message.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/rewake_codex_failure.py",
            "asyncRewake": true
          },
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/validate_completion.py",
            "timeout": 90
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/rm -f /tmp/claude-waiting-$TMUX_PANE"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$SUPERSET_HOME_DIR\" ] && [ -x \"$SUPERSET_HOME_DIR/hooks/notify.sh\" ] && SUPERSET_AGENT_ID=claude \"$SUPERSET_HOME_DIR/hooks/notify.sh\" || true"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/jordan/.claude/hooks/herdr-agent-state.sh' working",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/classify_intent.py",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/inject_honcho_memory.py",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/record_session_event.py"
          },
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/remember_architect_message.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/update_goal.py",
            "timeout": 70
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/close_abandoned_browsers.py",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/remember_agent_message.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/rewake_codex_failure.py",
            "asyncRewake": true
          }
        ]
      }
    ]
  },
  "worktree": {
    "bgIsolation": "none"
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "dev-browser@dev-browser-marketplace": false,
    "skill-creator@claude-plugins-official": true
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "medium",
  "agent": "cto",
  "autoUpdatesChannel": "latest",
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "fileCheckpointingEnabled": false,
  "teammateMode": "in-process",
  "remoteControlAtStartup": true,
  "voiceEnabled": true
}
