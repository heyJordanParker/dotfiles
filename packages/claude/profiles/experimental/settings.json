{
  "autoMemoryEnabled": false,
  "cleanupPeriodDays": 100000000,
  "env": {
    "ANTHROPIC_BASE_URL": "http://devbox:8317",
    "CLAUDE_CODE_ENABLE_FINE_GRAINED_TOOL_STREAMING": "1",
    "CLAUDE_CODE_MAX_CONTEXT_TOKENS": "272000",
    "ENABLE_TOOL_SEARCH": "true",
    "EDITOR": "prompt-editor",
    "USER_TYPE": "ant"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/combine_hooks.py block_composed_commands block_denied_access block_invalid_browsers",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/block_denied_access.py",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/close_abandoned_browsers.py",
            "timeout": 60
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/close_abandoned_browsers.py",
            "timeout": 60
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "AskUserQuestion"
    ],
    "defaultMode": "bypassPermissions"
  },
  "bashEditDiffEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "tui": "fullscreen"
}
