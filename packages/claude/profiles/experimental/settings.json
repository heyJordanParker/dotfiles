{
  "autoMemoryEnabled": false,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/block_invalid_browsers.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "mcp__plugin_honcho_honcho__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/block_memory_access.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "WebFetch|WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/block_research_web_tools.py",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/close_abandoned_browsers.py",
            "timeout": 60
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/close_abandoned_browsers.py",
            "timeout": 60
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "honcho@honcho": true
  },
  "extraKnownMarketplaces": {
    "honcho": {
      "source": {
        "source": "github",
        "repo": "plastic-labs/claude-honcho"
      }
    }
  },
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark"
}
