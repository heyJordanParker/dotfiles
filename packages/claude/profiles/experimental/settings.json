{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__plugin_honcho_honcho__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/block_memory_access.py",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "honcho@honcho": true
  },
  "extraKnownMarketplaces": {
    "honcho": {
      "source": {
        "source": "github",
        "repo": "plastic-labs/claude-honcho"
      }
    }
  },
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark"
}
