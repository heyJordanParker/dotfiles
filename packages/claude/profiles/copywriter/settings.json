{
  "fileSuggestion": {
    "type": "command",
    "command": "~/.claude/file-suggestion.sh"
  },
  "cleanupPeriodDays": 100000000,
  "skillListingBudgetFraction": 0.02,
  "env": {
    "ANTHROPIC_BASE_URL": "http://devbox:8317",
    "ANTHROPIC_SMALL_FAST_MODEL": "gpt-6-luna",
    "CLAUDE_CODE_ENABLE_FINE_GRAINED_TOOL_STREAMING": "1",
    "CLAUDE_CODE_MAX_CONTEXT_TOKENS": "272000",
    "ENABLE_TOOL_SEARCH": "true",
    "EDITOR": "prompt-editor",
    "USER_TYPE": "ant"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "deny": [
      "EnterWorktree",
      "AskUserQuestion",
      "ExitWorktree"
    ],
    "defaultMode": "bypassPermissions"
  },
  "bashEditDiffEnabled": false,
  "model": "opus",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/combine_hooks.py block_composed_commands block_denied_access block_invalid_browsers",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.agents/hooks/block_denied_access.py",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "worktree": {
    "bgIsolation": "none"
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "alwaysThinkingEnabled": true,
  "modelSettings": {
    "fable": {
      "effortLevel": "medium"
    },
    "opus": {
      "effortLevel": "high"
    }
  },
  "autoCompactWindow": 700000,
  "promptSuggestionEnabled": false,
  "agent": "copy-chief",
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "fileCheckpointingEnabled": false,
  "voiceEnabled": true
}
