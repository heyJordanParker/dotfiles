#!/bin/bash
# codex-run — run codex as one of our named agents. The mechanical wrapper the
# codex subagent drives; all logic lives in the runner module beside the hooks.
#
#   codex-run @<agent> "<prompt>"        run codex as <agent>
#   codex-run resume <job> "<msg>"       continue a prior run
#   codex-run status | result | log | events | history | cancel | watch
#
# The hooks dir goes on PYTHONPATH so the runner loads as `lib.codex_run`, the
# same way every hook loads it. Putting lib/ itself on the path instead made the
# runner import its siblings bare, which then failed for every hook that loaded
# it as part of the package.
HOOKS="$HOME/.agents/hooks"
exec python3 -c "import sys; sys.path.insert(0, '$HOOKS'); from lib import codex_run; sys.exit(codex_run.main(sys.argv[1:]))" "$@"
