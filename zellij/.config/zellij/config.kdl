// Zellij Configuration — line-by-line port of tmux.conf
// Parallel to tmux setup — both coexist

// --- Global Options (match tmux lines 30-37) ---
copy_command "pbcopy"                                  // tmux set-clipboard on
copy_on_select true
scroll_buffer_size 1000000                             // tmux history-limit 1000000
session_serialization true                             // replaces tmux-resurrect + tmux-continuum
mouse_mode true                                        // tmux mouse on
on_force_close "detach"                                // tmux detach-on-destroy off
default_mode "normal"
scrollback_editor "/usr/bin/env nvim"
// TESTING full 4-side borders for tmux-style per-pane top divider.
// REVERT: change `true` → `false` below — single-line flip, no other changes required.
// Original value: pane_frames false (thin inter-pane separators only, no title text).
pane_frames true
simplified_ui false

// Rounded frame corners (╭╮╰╯ instead of ┌┐└┘). Only takes effect when
// pane_frames=true. REVERT: flip `true` → `false` or delete the block.
ui {
    pane_frames {
        rounded_corners true
    }
}

// Use the custom layout with zjstatus bar
default_layout "default"

// --- Plugins ---
plugins {
    zjstatus location="https://github.com/dj95/zjstatus/releases/download/v0.22.0/zjstatus.wasm"
    autolock location="https://github.com/fresh2dev/zellij-autolock/releases/download/0.2.2/zellij-autolock.wasm" {
        triggers "nvim|vim|vi|fzf|zoxide|atuin"
        watch_triggers "fzf|zoxide|atuin"
        watch_interval "1.0"
    }
    session-manager location="zellij:session-manager"
    // Invisible plugin: normalizes tab names + manages attention indicators
    // via `zellij pipe --name "tab-bar-jordan::waiting::$ZELLIJ_PANE_ID"`.
    // Built by setup.sh from dotfiles/zellij/plugins/tab-bar-jordan/.
    tab-bar-jordan location="file:~/.config/zellij/plugins/tab-bar-jordan.wasm"
}

load_plugins {
    autolock
    tab-bar-jordan
}

theme "catppuccin-mocha"

// --- Keybindings ---
keybinds clear-defaults=true {

    // ============================================================
    // SHARED — all modes except text input
    // Alt-key bindings work without prefix (like tmux bind -n)
    // ============================================================
    shared_except "entersearch" "renametab" "renamepane" {

        // ========== POPUPS (tmux lines 42-58) ==========
        // Each popup uses zellij-toggle-term for persistent/toggle/reference behavior.
        // The tiny invisible runner pane (1x1) executes the script and closes immediately.
        //
        // Reset modes (matching tmux exactly):
        //   0 = persistent   (kept across invocations, state preserved)
        //   1 = reset on dir (recreate if caller's CWD changed)
        //   2 = always reset (fresh instance every time)

        // Alt+` — Global Scratch (mode 1: reset on dir change)
        bind "Alt `" {
            Run "bash" {
                args "-c" "$HOME/.local/bin/zellij-toggle-term global-scratch zsh 1"
                close_on_exit true
                floating true
                x "49%"
                y "49%"
                width "1"
                height "1"
            }
        }

        // Alt+v — Nvim (mode 0: persistent, shared nvim server)
        bind "Alt v" {
            Run "bash" {
                args "-c" "$HOME/.local/bin/zellij-toggle-term nvim-scratch $HOME/.local/bin/tmux-nvim 0"
                close_on_exit true
                floating true
                x "49%"
                y "49%"
                width "1"
                height "1"
            }
        }

        // Alt+g — Lazygit (mode 1: reset on dir change)
        bind "Alt g" {
            Run "bash" {
                args "-c" "$HOME/.local/bin/zellij-toggle-term lazygit-popup lazygit 1"
                close_on_exit true
                floating true
                x "49%"
                y "49%"
                width "1"
                height "1"
            }
        }

        // Alt+Esc — btop (mode 0: persistent)
        bind "Alt Esc" {
            Run "bash" {
                args "-c" "$HOME/.local/bin/zellij-toggle-term btop-popup btop 0"
                close_on_exit true
                floating true
                x "49%"
                y "49%"
                width "1"
                height "1"
            }
        }

        // Alt+e — superfile (mode 2: always reset)
        bind "Alt e" {
            Run "bash" {
                args "-c" "$HOME/.local/bin/zellij-toggle-term spf-popup spf 2"
                close_on_exit true
                floating true
                x "49%"
                y "49%"
                width "1"
                height "1"
            }
        }

        // Alt+c — Scrollback viewer (built-in, opens buffer in $EDITOR)
        // This is zellij's EditScrollback — opens the full scroll buffer in nvim
        // where Jordan gets full vim JKLI navigation. Superior to tmux's popup.
        bind "Alt c" { EditScrollback; SwitchToMode "Normal"; }

        // Alt+Shift+C — Copy current pane's CWD to clipboard (tmux line 121)
        bind "Alt C" {
            Run "bash" {
                args "-c" "$HOME/.local/bin/zellij-copy-cwd"
                close_on_exit true
                floating true
                x "49%"
                y "49%"
                width "1"
                height "1"
            }
        }

        // ========== TAB NAVIGATION (tmux lines 96-112) ==========
        bind "Alt 1" { GoToTab 1; }
        bind "Alt 2" { GoToTab 2; }
        bind "Alt 3" { GoToTab 3; }
        bind "Alt 4" { GoToTab 4; }
        bind "Alt 5" { GoToTab 5; }
        bind "Alt 6" { GoToTab 6; }
        bind "Alt 7" { GoToTab 7; }
        bind "Alt 8" { GoToTab 8; }
        bind "Alt 9" { GoToTab 9; }
        bind "Alt Tab" { ToggleTab; }                  // tmux M-Tab last-window
        bind "Alt [" { GoToPreviousTab; }              // tmux M-[ previous-window
        bind "Alt ]" { GoToNextTab; }                  // tmux M-] next-window

        // ========== PANE OPERATIONS ==========
        bind "Alt z" { ToggleFocusFullscreen; }        // tmux M-z zoom
        bind "Alt W" { CloseFocus; }                   // tmux M-W kill-pane

        // ========== PREFIX KEY — Ctrl+S ==========
        bind "Ctrl s" { SwitchToMode "Tmux"; }

        // ========== Shift+Enter → Alt+Enter translation (tmux line 137) ==========
        // Writes ESC (27) + CR (13) — the byte sequence for Alt+Enter.
        // Used by Claude Code, Codex, and other tools that expect M-Enter as newline.
        bind "Shift Enter" { Write 27 13; }
    }

    // ============================================================
    // NORMAL mode — pane navigation (passes through to vim via autolock)
    // ============================================================
    normal {
        // JKLI focus (tmux lines 79-82 + vim-aware)
        bind "Alt j" { MoveFocus "Left"; }
        bind "Alt k" { MoveFocus "Down"; }
        bind "Alt l" { MoveFocus "Right"; }
        bind "Alt i" { MoveFocus "Up"; }

        // JKLI resize (tmux lines 85-88)
        bind "Alt J" { Resize "Increase Left"; }
        bind "Alt K" { Resize "Increase Down"; }
        bind "Alt L" { Resize "Increase Right"; }
        bind "Alt I" { Resize "Increase Up"; }

        // JKLI split (tmux lines 91-94)
        // NewPane only supports Right/Down natively. For Left/Up, create on
        // the native side then MovePane the new (focused) pane to swap into
        // place. MovePane supports all 4 directions.
        bind "Alt Ctrl j" { NewPane "Right"; MovePane "Left"; }
        bind "Alt Ctrl k" { NewPane "Down"; }
        bind "Alt Ctrl l" { NewPane "Right"; }
        bind "Alt Ctrl i" { NewPane "Down"; MovePane "Up"; }
    }

    // ============================================================
    // LOCKED mode — autolock switches here when vim is focused
    // Only the unlock key is active; all other keys pass through
    // ============================================================
    locked {
        bind "Ctrl g" { SwitchToMode "Normal"; }
    }

    // ============================================================
    // TMUX mode — Ctrl+S prefix (matches tmux prefix bindings)
    // ============================================================
    tmux {
        // ========== Tab management (tmux lines 124-134) ==========
        bind "t" { NewTab; SwitchToMode "Normal"; }                    // tmux prefix+t
        bind "1" { GoToTab 1; SwitchToMode "Normal"; }
        bind "2" { GoToTab 2; SwitchToMode "Normal"; }
        bind "3" { GoToTab 3; SwitchToMode "Normal"; }
        bind "4" { GoToTab 4; SwitchToMode "Normal"; }
        bind "5" { GoToTab 5; SwitchToMode "Normal"; }
        bind "6" { GoToTab 6; SwitchToMode "Normal"; }
        bind "7" { GoToTab 7; SwitchToMode "Normal"; }
        bind "8" { GoToTab 8; SwitchToMode "Normal"; }
        bind "9" { GoToTab 9; SwitchToMode "Normal"; }
        bind "Tab" { ToggleTab; SwitchToMode "Normal"; }
        bind "]" { GoToNextTab; SwitchToMode "Normal"; }               // tmux prefix+]
        bind "[" { GoToPreviousTab; SwitchToMode "Normal"; }           // tmux prefix+[

        // ========== Pane splits (tmux lines 66-67, 301-304) ==========
        bind "|" { NewPane "Right"; SwitchToMode "Normal"; }           // tmux prefix+|
        bind "-" { NewPane "Down"; SwitchToMode "Normal"; }            // tmux prefix+-
        bind "J" { NewPane "Left"; SwitchToMode "Normal"; }            // tmux prefix+J
        bind "K" { NewPane "Down"; SwitchToMode "Normal"; }            // tmux prefix+K
        bind "L" { NewPane "Right"; SwitchToMode "Normal"; }           // tmux prefix+L
        bind "I" { NewPane "Up"; SwitchToMode "Normal"; }              // tmux prefix+I

        // ========== Pane focus (tmux lines 70-73) ==========
        bind "j" { MoveFocus "Left"; SwitchToMode "Normal"; }
        bind "k" { MoveFocus "Down"; SwitchToMode "Normal"; }
        bind "l" { MoveFocus "Right"; SwitchToMode "Normal"; }
        bind "i" { MoveFocus "Up"; SwitchToMode "Normal"; }

        // ========== Pane close (tmux lines 126-127) ==========
        bind "w" { CloseFocus; SwitchToMode "Normal"; }                // tmux prefix+w
        bind "W" { CloseTab; SwitchToMode "Normal"; }                  // tmux prefix+W

        // ========== Copy mode entry (tmux lines 140-142) ==========
        // Copy mode — opens scroll buffer in $EDITOR (nvim).
        // This IS zellij's official copy mode (per maintainer imsnif in
        // zellij-org/zellij#2840, #1486). With Jordan's nvim config
        // (clipboard=unnamedplus + JKLI remaps), identical keystrokes to
        // tmux copy-mode-vi: navigate with JKLI, `v` for visual, `y` yanks
        // to system clipboard, `:q` to exit.
        bind "c" { EditScrollback; SwitchToMode "Normal"; }            // tmux prefix+c copy-mode
        bind "/" { SwitchToMode "EnterSearch"; }                       // tmux prefix+/ search up
        bind "?" { SwitchToMode "EnterSearch"; }                       // tmux prefix+? search down

        // ========== Rename (tmux lines 151-152) ==========
        // Terminology: tmux "window" = zellij "tab"; tmux "session" = zellij "session"
        // tmux prefix+r rename-window → our own tab-bar-jordan plugin launched
        // in RenameTab mode: purpose-built input modal, no external shell.
        // The plugin pre-populates the input with the current tab's stripped
        // name, renames via `rename_tab_with_id` on Enter, and closes itself.
        bind "r" {
            LaunchOrFocusPlugin "tab-bar-jordan" {
                floating true
                move_to_focused_tab true
                skip_plugin_cache true
                mode "rename_tab"
            }
            SwitchToMode "Normal";
        }
        // prefix+R rename-session — same tab-bar-jordan plugin, launched in
        // RenameSession mode. Captures the current session name from
        // SessionUpdate, pre-populates the input, and renames via
        // `rename_session` on Enter (mirrors the prefix+r tab rename flow).
        bind "R" {
            LaunchOrFocusPlugin "tab-bar-jordan" {
                floating true
                move_to_focused_tab true
                skip_plugin_cache true
                mode "rename_session"
            }
            SwitchToMode "Normal";
        }

        // ========== Session management (tmux lines 132-134) ==========
        bind "n" { NewTab; SwitchToMode "Normal"; }                    // tmux prefix+n new-session (closest: new tab)
        bind "Q" { Detach; }                                           // tmux prefix+Q kill-session (detach is closest)
        bind "Ctrl f" { LaunchOrFocusPlugin "session-manager" { floating true; move_to_focused_tab true; }; SwitchToMode "Normal"; }  // tmux prefix+C-f find-window
        bind "Space" { LaunchOrFocusPlugin "session-manager" { floating true; move_to_focused_tab true; }; SwitchToMode "Normal"; }  // tmux sessionx (prefix+Space)

        // ========== Popup bindings in prefix mode (tmux lines 61-63) ==========
        bind "g" {
            Run "bash" {
                args "-c" "$HOME/.local/bin/zellij-toggle-term lazygit-popup lazygit 1"
                close_on_exit true
                floating true
                x "49%"
                y "49%"
                width "1"
                height "1"
            }
            SwitchToMode "Normal";
        }
        bind "b" {
            Run "bash" {
                args "-c" "$HOME/.local/bin/zellij-toggle-term btop-popup btop 0"
                close_on_exit true
                floating true
                x "49%"
                y "49%"
                width "1"
                height "1"
            }
            SwitchToMode "Normal";
        }
        bind "`" {
            Run "bash" {
                args "-c" "$HOME/.local/bin/zellij-toggle-term global-scratch zsh 1"
                close_on_exit true
                floating true
                x "49%"
                y "49%"
                width "1"
                height "1"
            }
            SwitchToMode "Normal";
        }

        // ========== Reload config (tmux line 156) ==========
        // Zellij has no built-in keybind action for reloading config from
        // disk — only a plugin-level `reconfigure` shim. Launch tab-bar-jordan
        // in reload_config mode: it shells out to `cat ~/.config/zellij/config.kdl`,
        // feeds the content to `reconfigure`, then calls `close_self`.
        // Launched floating + 1×1 so the plugin's brief lifetime is invisible.
        bind "C" {
            LaunchPlugin "tab-bar-jordan" {
                floating true
                skip_plugin_cache true
                mode "reload_config"
            }
            SwitchToMode "Normal";
        }

        // ========== Literal Ctrl+S (tmux send-prefix) ==========
        bind "Ctrl s" { Write 19; SwitchToMode "Normal"; }

        bind "Esc" { SwitchToMode "Normal"; }
    }

    // ============================================================
    // SCROLL mode — tmux copy-mode equivalent
    //
    // IMPORTANT: Zellij 0.44.1 does not have keyboard-based text selection.
    // Text selection is mouse-only (drag to select). `copy_on_select true`
    // auto-copies on mouse release. The `Copy` keybinding action copies
    // whatever is currently mouse-selected.
    //
    // Workflow matching tmux copy mode:
    //   prefix+c or direct bind → enter SCROLL mode
    //   k/i or Ctrl+U/D or PageUp/Down to scroll to target content
    //   U/O to jump to top/bottom of buffer
    //   drag with mouse to select (copy_on_select auto-copies)
    //   y or Enter to explicitly copy current selection
    //   / or s to search
    //   Esc or q to exit
    // ============================================================
    scroll {
        // Navigation (JKLI + arrows + page)
        bind "k" { ScrollDown; }
        bind "i" { ScrollUp; }
        bind "Down" { ScrollDown; }
        bind "Up" { ScrollUp; }
        bind "PageDown" { PageScrollDown; }
        bind "PageUp" { PageScrollUp; }
        bind "Ctrl d" { HalfPageScrollDown; }          // tmux halfpage-down
        bind "Ctrl u" { HalfPageScrollUp; }            // tmux halfpage-up
        bind "U" { ScrollToTop; }                      // tmux copy-mode U = history-top
        bind "O" { ScrollToBottom; }                   // tmux copy-mode O = history-bottom

        // Copy actions — operate on the current mouse-drag selection
        // Matches tmux's copy-pipe-and-cancel behavior (copy + exit mode)
        bind "y" { Copy; SwitchToMode "Normal"; }      // tmux copy-mode y = copy-pipe pbcopy
        bind "Enter" { Copy; SwitchToMode "Normal"; }  // tmux copy-mode Enter = copy-pipe pbcopy

        // Search (tmux copy-mode /? and [/])
        bind "s" { SwitchToMode "EnterSearch"; }
        bind "/" { SwitchToMode "EnterSearch"; }

        // Edit scrollback in $EDITOR — opens buffer in nvim for full vim yank/cut
        bind "e" { EditScrollback; SwitchToMode "Normal"; }

        // Exit
        bind "Esc" { ScrollToBottom; SwitchToMode "Normal"; }
        bind "q" { ScrollToBottom; SwitchToMode "Normal"; }
    }

    entersearch {
        bind "Enter" { SwitchToMode "Search"; }
        bind "Esc" { SwitchToMode "Scroll"; }
    }

    search {
        bind "]" { Search "down"; }                    // tmux search-again
        bind "[" { Search "up"; }                      // tmux search-reverse
        bind "n" { Search "down"; }
        bind "p" { Search "up"; }
        bind "c" { SearchToggleOption "CaseSensitivity"; }
        bind "w" { SearchToggleOption "WholeWord"; }
        bind "Esc" { SwitchToMode "Scroll"; }
    }

    renametab {
        bind "Enter" { SwitchToMode "Normal"; }
        bind "Esc" { UndoRenameTab; SwitchToMode "Normal"; }
    }

    renamepane {
        bind "Enter" { SwitchToMode "Normal"; }
        bind "Esc" { UndoRenamePane; SwitchToMode "Normal"; }
    }
}
