# multilspy auto-downloads language servers under the cwd by default.
# Keep them out of the repo — they're large and platform-specific.
.multilspy/
multilspy_logs/

# tracer's own disk cache — kept out of the repo by convention. Users of
# tracer in their projects should add this to their .gitignore too.
.tracer-cache/
